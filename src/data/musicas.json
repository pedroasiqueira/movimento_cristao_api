    "titulo": "Semente de Paz",
    "exemplo": true,
    "autores": [],
    "secoes": [
      {
        "tipo": "estrofe",
        "linhas": [
          "Uma semente pequenina",
          "plantada com afeição",
          "cresce mansa, cresce firme,",
          "floresce no coração."
        ]
      },
      {
        "tipo": "refrao",
        "linhas": [
          "Semear, semear a paz,",
          "no gesto e na palavra.",
          "O que se planta de manhã",
          "à noite já se lavra."
        ]
      },
      {
        "tipo": "estrofe",
        "linhas": [
          "Não se colhe no apresso",
          "o fruto da bondade:",
          "colhe-se com paciência,",
          "colhe-se em unidade."
        ]
      }
    ]
