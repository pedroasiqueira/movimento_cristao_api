# Copie para .env e troque os valores. O .env é ignorado pelo git — nunca o versione.

# MongoDB local (docker compose usa estas três para criar o root)
MONGODB_USERNAME=troque-isto
MONGODB_PASSWORD=troque-isto
MONGODB_DATABASE=movimento_cristao
# Porta 27019 no host — ver docker-compose.yaml
MONGODB_URI=mongodb://troque-isto:troque-isto@localhost:27019/movimento_cristao?authSource=admin

# Autenticação (JWT de 7 dias)
JWT_SECRET=troque-isto

# Administrador criado/atualizado pelo seed (npm run seed)
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@exemplo.com
ADMIN_PASSWORD=troque-isto

# Aplicação
PORT=3000
NODE_ENV=development
# Origem extra liberada no CORS além dos localhosts de desenvolvimento
FRONTEND_URL=http://localhost:5173
